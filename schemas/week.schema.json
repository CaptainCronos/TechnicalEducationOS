{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://technicaleducationos.local/schemas/week.schema.json",
  "title": "DEPRECATED: TechnicalEducationOS weekly compatibility record",
  "description": "Read-only compatibility schema. New curriculum uses instructional units and sessions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "course_id",
    "week_number",
    "title",
    "objectives",
    "lectures",
    "labs",
    "assessments"
  ],
  "anyOf": [
    {"properties": {"lectures": {"minItems": 1}}},
    {"required": ["lessons"]}
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "course_id": {"$ref": "#/$defs/id"},
    "week_number": {"type": "integer", "minimum": 1, "maximum": 99},
    "title": {"type": "string", "minLength": 1},
    "preparation": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "competency_ids"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "statement": {"type": "string", "minLength": 1},
          "competency_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/id"}
          }
        }
      }
    },
    "lectures": {
      "type": "array",
      "items": {"$ref": "#/$defs/lecture"}
    },
    "labs": {
      "type": "array",
      "items": {"$ref": "#/$defs/lab"}
    },
    "assessments": {
      "type": "array",
      "items": {"$ref": "#/$defs/assessment"}
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/lesson"}
    },
    "teaching_notes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "id_list": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/id"}
    },
    "lecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "objective_ids", "duration_minutes", "topics"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "objective_ids": {"$ref": "#/$defs/id_list"},
        "duration_minutes": {"type": "integer", "minimum": 1},
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "instructor_notes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "lab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "objective_ids",
        "duration_minutes",
        "procedure",
        "deliverables"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "objective_ids": {"$ref": "#/$defs/id_list"},
        "duration_minutes": {"type": "integer", "minimum": 1},
        "procedure": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "safety_notes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "objective_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "type": {
          "enum": ["diagnostic", "formative", "summative"]
        },
        "objective_ids": {"$ref": "#/$defs/id_list"},
        "description": {"type": "string", "minLength": 1},
        "question_bank": {
          "type": "array",
          "items": {"$ref": "#/$defs/question"}
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "day_number",
        "title",
        "objective_ids",
        "duration",
        "objective_summary",
        "essential_question",
        "materials",
        "terminology",
        "activities",
        "assessment_ids",
        "industry_applications",
        "common_technician_errors",
        "instructor_shop_tip",
        "homework",
        "flex_activities"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "day_number": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "objective_ids": {"$ref": "#/$defs/id_list"},
        "duration": {"$ref": "#/$defs/duration"},
        "objective_summary": {"type": "string", "minLength": 1},
        "essential_question": {"type": "string", "minLength": 1},
        "materials": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "terminology": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "activities": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/activity"}
        },
        "assessment_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/id"}
        },
        "industry_applications": {"type": "string", "minLength": 1},
        "common_technician_errors": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "instructor_shop_tip": {"type": "string", "minLength": 1},
        "homework": {"type": "string", "minLength": 1},
        "flex_activities": {"type": "string", "minLength": 1}
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_minutes", "segments"],
      "properties": {
        "total_minutes": {"type": "integer", "minimum": 1},
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "minutes"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "minutes": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "description", "objective_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "category": {
          "enum": ["warm_up", "academic", "shop", "exit"]
        },
        "description": {"type": "string", "minLength": 1},
        "objective_ids": {"$ref": "#/$defs/id_list"}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "type", "objective_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "prompt": {"type": "string", "minLength": 1},
        "type": {
          "enum": ["multiple_choice", "short_answer", "performance"]
        },
        "objective_ids": {"$ref": "#/$defs/id_list"},
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "answer": {"type": "string", "minLength": 1},
        "rubric": {"type": "string", "minLength": 1}
      }
    }
  }
}
