{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://technicaleducationos.local/schemas/academic-calendar.schema.json",
  "title": "TechnicalEducationOS academic calendar",
  "description": "Term boundaries and instructional availability; never curriculum or course meetings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "calendar_id",
    "institution_id",
    "term_id",
    "name",
    "first_day",
    "last_day",
    "events"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "calendar_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "institution_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "term_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {"type": "string", "minLength": 1},
    "first_day": {"type": "string", "format": "date"},
    "last_day": {"type": "string", "format": "date"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "start_date", "end_date"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {
            "enum": [
              "holiday",
              "break",
              "faculty_work_day",
              "graduation",
              "institutional_closure"
            ]
          },
          "start_date": {"type": "string", "format": "date"},
          "end_date": {"type": "string", "format": "date"},
          "instructional": {"type": "boolean"}
        }
      }
    }
  }
}
