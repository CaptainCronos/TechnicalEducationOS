{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://technicaleducationos.local/schemas/institution.schema.json",
  "title": "TechnicalEducationOS institution profile",
  "description": "Operational scheduling and presentation configuration; never curriculum.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "institution_id",
    "institution_name",
    "academic_year",
    "meeting_patterns"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "institution_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "institution_name": {"type": "string", "minLength": 1},
    "academic_year": {
      "type": "object",
      "additionalProperties": false,
      "required": ["academic_year_id", "name", "start_date", "end_date", "terms"],
      "properties": {
        "academic_year_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {"type": "string", "minLength": 1},
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": "string", "format": "date"},
        "terms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["term_id", "name", "calendar_id"],
            "properties": {
              "term_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "name": {"type": "string", "minLength": 1},
              "calendar_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              }
            }
          }
        }
      }
    },
    "meeting_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern_id", "name", "starts_on", "meetings"],
        "properties": {
          "pattern_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "name": {"type": "string", "minLength": 1},
          "starts_on": {"type": "string", "format": "date"},
          "ends_on": {"type": "string", "format": "date"},
          "first_week_number": {"type": "integer", "minimum": 1},
          "meetings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["weekday", "day", "start_time", "duration_minutes"],
              "properties": {
                "weekday": {
                  "enum": [
                    "monday",
                    "tuesday",
                    "wednesday",
                    "thursday",
                    "friday",
                    "saturday",
                    "sunday"
                  ]
                },
                "day": {"type": "integer", "minimum": 1},
                "start_time": {
                  "type": "string",
                  "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "duration_minutes": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    },
    "class_length_minutes": {"type": "integer", "minimum": 1},
    "program_structure": {"type": "object"},
    "lesson_plan_templates": {"type": "object"},
    "branding": {"type": "object"},
    "footer_requirements": {"type": "array", "items": {"type": "string"}},
    "required_administrative_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    },
    "attendance_policy": {"type": "object"},
    "lms": {"type": "object"},
    "grading": {"type": "object"},
    "assessment_policy": {"type": "object"},
    "report_formats": {"type": "object"}
  }
}
